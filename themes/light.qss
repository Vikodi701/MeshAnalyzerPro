
/* ==========================================================
   MeshAnalyzer Pro - LIGHT THEME
   Clean Final Theme System
========================================================== */

/* ---------- GLOBAL ---------- */

QMainWindow,
QWidget {
    background-color: #F8FAFC;
    color: #0F172A;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10.5pt;
}

QLabel {
    background: transparent;
    color: #0F172A;
}

QFrame {
    background: transparent;
    border: none;
}

/* ---------- PAGE TITLES ---------- */

QLabel#PageTitle {
    background: transparent;
    color: #0F172A;
    font-size: 22pt;
    font-weight: 800;
    padding: 12px;
}

QLabel#SectionTitle {
    background: transparent;
    color: #0F172A;
    font-size: 12pt;
    font-weight: 800;
    padding: 6px;
}

/* ==========================================================
   MENU BAR
========================================================== */

QMenuBar {
    background-color: #FFFFFF;
    color: #0F172A;
    border-bottom: 1px solid #CBD5E1;
    padding: 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #E2E8F0;
    color: #0F172A;
}

QMenu {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    padding: 6px;
}

QMenu::item {
    padding: 7px 26px 7px 22px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #DBEAFE;
    color: #0F172A;
}

QMenu::separator {
    height: 1px;
    background-color: #CBD5E1;
    margin: 6px 4px;
}

/* ==========================================================
   TOOLBAR
========================================================== */

QToolBar#MainToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #CBD5E1;
    spacing: 8px;
    padding: 8px;
}

QToolBar#MainToolBar QToolButton {
    background-color: transparent;
    color: #334155;
    border: none;
    border-radius: 10px;
    padding: 8px 12px;
    font-weight: 600;
}

QToolBar#MainToolBar QToolButton:hover {
    background-color: #F1F5F9;
    color: #0F172A;
}

QToolBar#MainToolBar QToolButton:pressed {
    background-color: #DBEAFE;
    color: #0F172A;
}

QToolBar::separator {
    background-color: #CBD5E1;
    width: 1px;
    margin: 6px;
}

/* ==========================================================
   SIDEBAR
========================================================== */

QWidget#SideBar {
    background-color: #FFFFFF;
    border-right: 1px solid #CBD5E1;
}

QLabel#SideBarTitle {
    background-color: transparent;
    color: #0F172A;
    font-size: 18px;
    font-weight: 800;
    padding: 12px 4px;
}

QPushButton#SideBarButton {
    background-color: transparent;
    color: #334155;
    border: none;
    border-radius: 10px;
    padding: 10px 14px;
    text-align: left;
    font-size: 11pt;
    font-weight: 600;
}

QPushButton#SideBarButton:hover {
    background-color: #F1F5F9;
    color: #0F172A;
}

QPushButton#SideBarButton:pressed {
    background-color: #E2E8F0;
}

QPushButton#SideBarButton:checked {
    background-color: #DBEAFE;
    color: #0F172A;
    font-weight: 800;
    border-left: 5px solid #2563EB;
}

/* ==========================================================
   BUTTONS / INPUTS
========================================================== */

QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 9px 14px;
    font-weight: 700;
}

QPushButton:hover {
    background-color: #1D4ED8;
}

QPushButton:pressed {
    background-color: #1E40AF;
}

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 6px 8px;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border: 1px solid #0284C7;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #0F172A;
    selection-background-color: #DBEAFE;
    selection-color: #0F172A;
    border: 1px solid #CBD5E1;
}

/* ==========================================================
   TABLES
========================================================== */

QTableWidget {
    background-color: #FFFFFF;
    color: #0F172A;
    gridline-color: #CBD5E1;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    selection-background-color: #0F172A;
    selection-color: #FFFFFF;
}

QTableWidget::item {
    border: none;
    padding: 6px;
}

QTableWidget::viewport {
    background-color: #FFFFFF;
}

QStackedWidget#MeshStack {
    background-color: transparent;
    border: none;
}

QLabel#EmptyStateLabel {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 14px;
    padding: 32px;
}

QTableWidget::item:selected {
    background-color: #F8FAFC;
    color: #0F172A;
    border: 3px solid #0284C7;
    font-weight: 800;
}

QHeaderView::section {
    background-color: #F1F5F9;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    padding: 8px;
    font-weight: 800;
}

QTableCornerButton::section {
    background-color: #F1F5F9;
    border: 1px solid #CBD5E1;
}

/* ==========================================================
   BASE CARD SYSTEM
========================================================== */

QFrame#BaseCard {
    background-color: #FFFFFF;
    border: 3px solid #2563EB;
    border-radius: 14px;
}

QFrame#BaseCard[accent="blue"] {
    border-color: #2563EB;
}

QFrame#BaseCard[accent="green"] {
    border-color: #16A34A;
}

QFrame#BaseCard[accent="yellow"] {
    border-color: #CA8A04;
}

QFrame#BaseCard[accent="red"] {
    border-color: #DC2626;
}

QFrame#BaseCard[accent="purple"] {
    border-color: #9333EA;
}

QFrame#BaseCard[accent="orange"] {
    border-color: #EA580C;
}

QFrame#BaseCard[accent="teal"] {
    border-color: #0D9488;
}

QFrame#BaseCard[accent="gray"] {
    border-color: #64748B;
}

QWidget#CardTitleRow {
    background: transparent;
    border: none;
}

QLabel#CardTitleText {
    background: transparent;
    color: #334155;
    font-size: 11pt;
    font-weight: 800;
}

QLabel#CardValue {
    background: transparent;
    color: #0F172A;
    font-size: 20pt;
    font-weight: 800;
}

QLabel#CardFooter {
    background: transparent;
    color: #64748B;
    font-size: 10pt;
}

/* ==========================================================
   SHARED SECTION TITLE
========================================================== */

QWidget#SectionTitleWidget {
    background: transparent;
    border: none;
}

QLabel#SectionTitleText {
    background: transparent;
    border: none;
    color: #0F172A;
    font-size: 12pt;
    font-weight: 800;
}

/* ==========================================================
   SUMMARY CARD
========================================================== */

QFrame#SummaryCard {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 14px;
}

QLabel#SummaryLabel {
    background: transparent;
    color: #64748B;
    font-weight: 600;
}

QLabel#SummaryValue {
    background: transparent;
    color: #0F172A;
    font-weight: 800;
}

QWidget#SummaryMetricLabel,
QFrame#SummarySeparator {
    background: transparent;
    border: none;
}

/* Backward compatibility */
QFrame#MeshSummaryCard {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 14px;
}

QLabel#MeshSummaryLabel {
    background: transparent;
    color: #64748B;
    font-weight: 600;
}

QLabel#MeshSummaryValue {
    background: transparent;
    color: #0F172A;
    font-weight: 800;
}

/* ==========================================================
   COLOR BAR
========================================================== */

QWidget#ColorBarWidget {
    background: transparent;
    border: none;
}

QLabel#ColorBarTitle {
    background: transparent;
    color: #0F172A;
    font-size: 12pt;
    font-weight: 800;
}

QLabel#ColorBarValue {
    background: transparent;
    color: #0F172A;
    font-weight: 800;
}

QFrame#ColorBarGradient,
QFrame#MeshColorBar {
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    background: qlineargradient(
        x1:0, y1:1,
        x2:0, y2:0,
        stop:0 #2563EB,
        stop:0.50 #22C55E,
        stop:1 #DC2626
    );
}

/* ==========================================================
   INFO ICON / INFO POPUP
========================================================== */

QLabel#InfoIcon {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
}

QFrame#InfoPopup {
    background-color: #FFFFFF;
    border: 1px solid #0284C7;
    border-radius: 14px;
}

QLabel#InfoPopupLabel {
    background: transparent;
    color: #0F172A;
    font-size: 10.5pt;
}

/* Legacy QToolTip */
QToolTip {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #0284C7;
    border-radius: 8px;
    padding: 8px;
}

/* ==========================================================
   SCROLLBARS
========================================================== */

QScrollBar:vertical {
    background: #F8FAFC;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #F8FAFC;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ==========================================================
   STATUS BAR
========================================================== */

QStatusBar {
    background-color: #FFFFFF;
    color: #334155;
    border-top: 1px solid #CBD5E1;
}

/* Mesh View sidebar-matched background start */
QWidget#MeshPage {
    background-color: #F8FAFC;
}

QStackedWidget#MeshStack {
    background-color: #F8FAFC;
    border: none;
}

QTableWidget#MeshTable {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    color: #0F172A;
    gridline-color: #CBD5E1;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    selection-background-color: #DBEAFE;
    selection-color: #0F172A;
}

QTableWidget#MeshTable::viewport {
    background-color: #FFFFFF;
}

QTableWidget#MeshTable::item {
    border: none;
    padding: 6px;
}

QTableWidget#MeshTable::item:selected {
    background-color: #DBEAFE;
    color: #0F172A;
    font-weight: bold;
}

QHeaderView::section {
    background-color: #F1F5F9;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    padding: 6px;
    font-weight: bold;
}

QLabel#EmptyStateLabel {
    background-color: #F8FAFC;
    color: #0F172A;
    border: none;
    padding: 0px;
    margin: 0px;
}

QLabel#EmptyStateSubLabel {
    background-color: #F8FAFC;
    color: #475569;
    border: none;
    font-size: 14px;
    font-weight: 500;
}
/* Mesh View sidebar-matched background end */

/* Settings reset buttons start */
QPushButton#SmallResetButton {
    background-color: #F8FAFC;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 6px 10px;
    font-weight: 600;
    min-height: 30px;
}

QPushButton#SmallResetButton:hover {
    background-color: #E2E8F0;
    border-color: #3B82F6;
}

QPushButton#SmallResetButton:pressed {
    background-color: #2563EB;
    color: #FFFFFF;
}
/* Settings reset buttons end */

/* Settings custom spin buttons start */
QDoubleSpinBox {
    padding-right: 8px;
}

QWidget#SpinStepContainer {
    background: transparent;
    border: none;
    min-width: 30px;
    max-width: 30px;
}

QToolButton#SpinStepButton {
    background-color: #F1F5F9;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 5px;
    min-width: 26px;
    max-width: 26px;
    min-height: 16px;
    max-height: 16px;
    padding: 0px;
    font-size: 9px;
    font-weight: 900;
}

QToolButton#SpinStepButton:hover {
    background-color: #E2E8F0;
    border-color: #38BDF8;
}

QToolButton#SpinStepButton:pressed {
    background-color: #2563EB;
    color: #FFFFFF;
}
/* Settings custom spin buttons end */

/* Settings label info row start */
QWidget#SettingsLabelInfoRow { background: transparent; border: none; }
/* Settings label info row end */

/* Settings graph defaults start */
QLabel#SettingsSectionTitle {
    color: #0F172A;
    background-color: #F8FAFC;
    border-left: 4px solid #2563EB;
    border-radius: 8px;
    padding: 8px 12px;
    margin-top: 12px;
    font-size: 15px;
    font-weight: 800;
}
/* Settings graph defaults end */

/* Dashboard disclaimer start */
QLabel#DashboardDisclaimer {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-left: 5px solid #D97706;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 10.5pt;
    font-weight: 600;
}
/* Dashboard disclaimer end */

/* Settings grouped cards start */
QScrollArea#SettingsScrollArea {
    background: transparent;
    border: none;
}

QWidget#SettingsScrollContent {
    background: transparent;
}

QFrame#SettingsGroupFrame {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 12px;
}
/* Settings grouped cards end */

/* Settings no scroll compact start */
QLabel#SettingsSectionTitle {
    padding: 6px 10px;
    margin-top: 0px;
    font-size: 13px;
    font-weight: 800;
}

QFrame#SettingsGroupFrame {
    min-height: 0px;
}

QCheckBox {
    min-height: 18px;
    padding: 2px 4px;
}

QComboBox {
    min-height: 26px;
}

QDoubleSpinBox {
    min-height: 26px;
}

QPushButton#SmallResetButton {
    min-height: 26px;
}
/* Settings no scroll compact end */

/* History row selection start */
QTableWidget::item:focus {
    outline: none;
    border: none;
}

QTableWidget::item:selected {
    outline: none;
}
/* History row selection end */

/* Coordinate standard info start */
QLabel#CoordinateStandardInfo {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-left: 5px solid #0284C7;
    border-radius: 9px;
    padding: 7px 12px;
    font-size: 10pt;
    font-weight: 600;
}
/* Coordinate standard info end */

/* Conf help card start */
QFrame#ConfHelpCard {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-left: 4px solid #0284C7;
    border-radius: 10px;
}

QLabel#ConfHelpTitle {
    color: #0F172A;
    font-size: 10.5pt;
    font-weight: 800;
}

QPushButton#ConfHelpButton {
    background-color: #F8FAFC;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 7px;
    padding: 6px 8px;
    font-size: 9.5pt;
    font-weight: 700;
    text-align: center;
}

QPushButton#ConfHelpButton:hover {
    background-color: #DBEAFE;
    border-color: #0284C7;
}
/* Conf help card end */

/* Conf help clickable link start */
QTextBrowser#ConfHelpTextBrowser {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 10px;
}

QTextBrowser#ConfHelpTextBrowser a {
    color: #0284C7;
}
/* Conf help clickable link end */
